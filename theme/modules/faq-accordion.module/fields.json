[
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "surface",
        "Surface (default light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "primary",
        "Primary (brand colour)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  },
  {
    "name": "overline",
    "label": "Overline / eyebrow",
    "type": "text",
    "default": ""
  },
  {
    "name": "section_heading",
    "label": "Section heading",
    "type": "text"
  },
  {
    "name": "items",
    "label": "Items",
    "type": "group",
    "occurrence": {
      "min": 1,
      "default": 1
    },
    "children": [
      {
        "name": "title",
        "label": "Title",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "name": "body_text",
        "label": "Body",
        "type": "richtext",
        "required": true,
        "default": ""
      },
      {
        "name": "is_open_default",
        "label": "Open by default",
        "type": "boolean",
        "default": false
      }
    ]
  },
  {
    "name": "emit_jsonld",
    "label": "Emit FAQ schema markup",
    "type": "boolean",
    "default": true
  },
  {
    "name": "contact_cta_label",
    "label": "Contact CTA label (beside FAQ)",
    "type": "text",
    "help_text": "Optional CTA shown in the left sidebar beside the FAQ list at desktop."
  },
  {
    "name": "contact_cta_link",
    "label": "Contact CTA link",
    "type": "link"
  }
]
