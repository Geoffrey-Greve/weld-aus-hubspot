[
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "surface",
        "Surface (default light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "primary",
        "Primary (brand colour)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  },
  {
    "name": "headline",
    "label": "Headline",
    "type": "text",
    "required": true,
    "default": ""
  },
  {
    "name": "subheadline",
    "label": "Sub-headline",
    "type": "richtext"
  },
  {
    "name": "eyebrow",
    "label": "Eyebrow / overline",
    "type": "text",
    "help_text": "Small uppercase label shown above the headline. Optional.",
    "default": ""
  },
  {
    "name": "search_placeholder",
    "label": "Search placeholder",
    "type": "text",
    "default": "Search resources..."
  },
  {
    "name": "search_target",
    "label": "Search target",
    "type": "choice",
    "choices": [
      [
        "resource_library",
        "Resource Library"
      ],
      [
        "find_a_member",
        "Find a Member"
      ],
      [
        "course_timetable",
        "Course Timetable"
      ]
    ],
    "required": true,
    "default": "resource_library"
  },
  {
    "name": "background_image",
    "label": "Background image",
    "type": "image"
  }
]
