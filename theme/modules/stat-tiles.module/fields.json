[
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "surface",
        "Surface (default light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "primary",
        "Primary (brand colour)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  },
  {
    "name": "section_heading",
    "label": "Section heading",
    "type": "text"
  },
  {
    "name": "tile_style",
    "label": "Tile style",
    "type": "choice",
    "choices": [
      [
        "plain",
        "Plain (number + label)"
      ],
      [
        "alternating",
        "Alternating cards (navy / white)"
      ]
    ],
    "default": "plain",
    "help_text": "Alternating renders each stat as a rounded card, alternating a filled navy card with a navy-outlined white card."
  },
  {
    "name": "stats",
    "label": "Stats",
    "type": "group",
    "occurrence": {
      "min": 2,
      "max": 6,
      "default": 4
    },
    "children": [
      {
        "name": "value_text",
        "label": "Value",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "name": "label_text",
        "label": "Label",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "name": "icon",
        "label": "Icon",
        "type": "image"
      }
    ]
  }
]
