  {
    "name": "form",
    "label": "General enquiry form",
    "type": "form",
    "required": true,
    "embed_versions": ["v2", "v4"],
    "disable_inline_form_editing": true,
    "help_text": "Submission target for the General enquiry tab (v2 or v4 forms). The form UI is theme-styled; include matching properties on the HubSpot form (firstname, lastname, email, phone, company, message, hs_ticket_category).",
    "default": {
      "form_id": "",
      "response_type": "inline",
      "message": "Thanks for getting in touch."
    }
  },
  {
    "name": "enable_soldamatic_selector",
    "label": "Enable Soldamatic support selector",
    "type": "boolean",
    "default": true,
    "help_text": "Adds a top-level General enquiry / Soldamatic support selector and swaps the form fields/sidebar for Soldamatic support requests."
  },
  {
    "name": "soldamatic_form",
    "label": "Soldamatic support form",
    "type": "form",
    "embed_versions": ["v2", "v4"],
    "disable_inline_form_editing": true,
    "help_text": "Submission target for the Soldamatic tab. Leave blank to submit Soldamatic requests to the General enquiry form instead.",
    "default": {
      "form_id": "",
      "response_type": "inline",
      "message": "Thanks for your support request."
    },
    "visibility": {
      "controlling_field": "enable_soldamatic_selector",
      "controlling_value_regex": "true",
      "operator": "EQUAL"
    }
  },
