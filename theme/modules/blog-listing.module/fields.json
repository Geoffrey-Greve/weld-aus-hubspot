  {
    "name": "section_heading",
    "label": "Section heading",
    "type": "text",
    "default": "News & insights"
  },
  {
    "name": "blog_id",
    "label": "Blog",
    "type": "blog"
  },
  {
    "name": "max_count",
    "label": "Max posts",
    "type": "number",
    "default": 3
  },
  {
    "name": "show_filter_chips",
    "label": "Show filter chips (tags)",
    "type": "boolean",
    "default": false
  },
  {
    "name": "tag_filter",
    "label": "Filter by tag (optional)",
    "type": "tag"
  },
  {
    "name": "view_all_label",
    "label": "View all label",
    "type": "text",
    "default": "View all news"
  },
  {
    "name": "view_all_link",
    "label": "View all link",
    "type": "link"
  }
