[
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      ["surface", "Surface (default light)"],
      ["surface_alt", "Alt surface (subtle grey)"],
      ["primary", "Primary (brand colour)"],
      ["primary_dark", "Primary dark"],
      ["transparent", "Transparent"]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      ["compact", "Compact (32px)"],
      ["default", "Default (64px)"],
      ["spacious", "Spacious (96px)"]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      ["mobile", "Mobile"],
      ["tablet", "Tablet"],
      ["desktop", "Desktop"]
    ],
    "default": ["mobile", "tablet", "desktop"]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  },
  {
    "name": "section_heading",
    "label": "Section heading",
    "type": "text",
    "default": "Pricing"
  },
  {
    "name": "intro",
    "label": "Intro",
    "type": "richtext"
  },
  {
    "name": "show_member_discount_callout",
    "label": "Show member savings callout",
    "type": "boolean",
    "default": true
  },
  {
    "name": "member_savings_message",
    "label": "Member savings message",
    "type": "text",
    "default": "Members save {amount} on this course."
  },
  {
    "name": "tiers",
    "label": "Pricing tiers",
    "type": "group",
    "occurrence": { "min": 1, "max": 4, "default": 2 },
    "children": [
      {
        "name": "tier_name",
        "label": "Tier name",
        "type": "text"
      },
      {
        "name": "price_member",
        "label": "Member price (display)",
        "type": "text"
      },
      {
        "name": "price_non_member",
        "label": "Non-member price (display)",
        "type": "text"
      },
      {
        "name": "includes",
        "label": "Includes (rich text bullets)",
        "type": "richtext"
      },
      {
        "name": "cta_label",
        "label": "CTA label",
        "type": "text"
      },
      {
        "name": "cta_link",
        "label": "CTA link",
        "type": "link"
      }
    ]
  }
]
