    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      ["surface", "Surface (default light)"],
      ["surface_alt", "Alt surface (subtle grey)"],
      ["primary", "Primary (brand colour)"],
      ["primary_dark", "Primary dark"],
      ["transparent", "Transparent"]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      ["compact", "Compact (32px)"],
      ["default", "Default (64px)"],
      ["spacious", "Spacious (96px)"]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      ["mobile", "Mobile"],
      ["tablet", "Tablet"],
      ["desktop", "Desktop"]
    ],
    "default": ["mobile", "tablet", "desktop"]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this entire section is only rendered for logged-in active members."
