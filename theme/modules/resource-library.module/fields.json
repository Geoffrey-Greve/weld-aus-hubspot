      ["report", "Reports"],
      ["webinar", "Webinars"],
      ["template", "Templates"],
      ["advocacy", "Advocacy"]
    ]
  },
  {
    "name": "default_filter_category",
    "label": "Default filter category",
    "type": "choice",
    "choices": [
      ["all", "All"],
      ["technical", "Technical"],
      ["standards", "Standards"],
      ["case_study", "Case Study"],
      ["report", "Report"],
      ["webinar", "Webinar"],
      ["template", "Template"],
      ["advocacy", "Advocacy"]
