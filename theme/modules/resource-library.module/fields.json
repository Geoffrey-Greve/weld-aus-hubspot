  {
    "name": "locked_cta_label",
    "label": "Locked CTA label",
    "type": "text",
    "default": "Become a member to access"
  },
  {
    "name": "locked_cta_link",
    "label": "Locked CTA link",
    "type": "link",
    "default": {
      "url": {
        "type": "EXTERNAL",
        "href": "/membership/"
      },
      "open_in_new_tab": false,
      "no_follow": false
    }
  },
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
