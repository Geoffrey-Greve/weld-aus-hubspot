[
  {
    "name": "form",
    "label": "Subscription form",
    "type": "form",
    "required": true,
    "help_text": "Required for signup to work. Select the HubSpot form that should receive subscriptions. On the events page this powers the email card; elsewhere the full form is embedded.",
    "default": {
      "form_id": "",
      "response_type": "inline",
      "message": "Thanks for subscribing."
    }
  },
  {
    "name": "heading",
    "label": "Heading",
    "type": "text"
  },
  {
    "name": "intro",
    "label": "Intro",
    "type": "richtext"
  },
  {
    "name": "subscription_options",
    "label": "Subscription options to surface",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "advocacy",
        "Advocacy"
      ],
      [
        "training",
        "Training"
      ],
      [
        "membership",
        "Membership"
      ],
      [
        "events",
        "Events"
      ],
      [
        "newsletter",
        "Newsletter"
      ]
    ],
    "default": [
      "advocacy",
      "training",
      "membership",
      "events",
      "newsletter"
    ]
  },
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "surface",
        "Surface (default light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "primary",
        "Primary (brand colour)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  }
]
