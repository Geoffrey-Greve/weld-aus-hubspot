[
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "surface",
        "Surface (default light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "primary",
        "Primary (brand colour)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  },
  {
    "name": "section_heading",
    "label": "Section heading",
    "type": "text"
  },
  {
    "name": "cards",
    "label": "Cards",
    "type": "group",
    "occurrence": {
      "min": 2,
      "max": 4,
      "default": 3
    },
    "children": [
      {
        "name": "image",
        "label": "Image",
        "type": "image",
        "default": {
          "src": "",
          "alt": "",
          "width": 0,
          "height": 0
        }
      },
      {
        "name": "heading",
        "label": "Heading",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "name": "body_text",
        "label": "Body",
        "type": "richtext"
      },
      {
        "name": "cta_label",
        "label": "CTA label",
        "type": "text",
        "default": "Learn more"
      },
      {
        "name": "cta_link",
        "label": "CTA link",
        "type": "link"
      }
    ]
  }
]
