  {
    "name": "newsletter_form",
    "label": "Newsletter form",
    "type": "form",
    "help_text": "Select the HubSpot form for the footer newsletter signup. Use an email-only form: the footer collects just the email address, so a form with other required fields or a consent checkbox will be rejected. Point those at the /subscribe page instead. Leave blank to show a link to /subscribe rather than a signup field.",
    "disable_inline_form_editing": true,
    "default": {
      "form_id": "",
      "response_type": "inline",
      "message": "Thanks for subscribing."
    }
  },
  {
    "name": "newsletter_button_text",
