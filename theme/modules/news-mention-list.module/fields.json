[
  {
    "name": "section_heading",
    "label": "Section heading",
    "type": "text",
    "default": "In the news"
  },
  {
    "name": "mentions",
    "label": "Mentions",
    "type": "group",
    "occurrence": {
      "min": 1,
      "default": 1
    },
    "children": [
      {
        "name": "publication_logo",
        "label": "Publication logo",
        "type": "image"
      },
      {
        "name": "headline",
        "label": "Headline",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "name": "publication_date",
        "label": "Publication date",
        "type": "date"
      },
      {
        "name": "link",
        "label": "Link",
        "type": "url",
        "required": true,
        "default": {
          "type": "EXTERNAL",
          "href": ""
        }
      }
    ]
  },
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "surface",
        "Surface (default light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "primary",
        "Primary (brand colour)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  }
]
