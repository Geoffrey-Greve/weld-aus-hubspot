    "default": "surface"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact"
      ],
      [
        "default",
        "Default"
      ],
      [
        "spacious",
        "Spacious"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, only rendered for logged-in active members."
  }
]
