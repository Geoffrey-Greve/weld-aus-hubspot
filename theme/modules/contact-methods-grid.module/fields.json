[
  {
    "name": "style",
    "label": "Display style",
    "type": "choice",
    "choices": [
      [
        "feature",
        "Feature cards (icon + heading + body)"
      ],
      [
        "directory",
        "Directory list (numbered departments)"
      ],
      [
        "legacy",
        "Basic grid (label + value)"
      ]
