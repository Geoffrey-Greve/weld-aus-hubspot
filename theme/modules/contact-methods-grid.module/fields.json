      {
        "name": "value_text",
        "label": "Value (display)",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "name": "link",
        "label": "Link (tel:/mailto:/url)",
        "type": "text"
      },
      {
        "name": "icon",
        "label": "Icon",
        "type": "image"
      }
    ]
  },
  {
    "name": "section_id",
    "label": "Section anchor ID",
    "type": "text",
