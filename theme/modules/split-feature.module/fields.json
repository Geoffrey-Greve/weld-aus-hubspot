        "HubDB certification pathways"
      ]
    ],
    "default": "manual",
    "help_text": "Used for info cards. HubDB mode reads public certification pathway rows and falls back to manual items if none are found.",
    "visibility": {
      "controlling_field_path": "media_type",
      "operator": "EQUAL",
      "controlling_value_regex": "info_cards"
