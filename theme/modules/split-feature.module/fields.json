  {
    "name": "video_source",
    "label": "Video source",
    "type": "choice",
    "display": "radio",
    "choices": [
      [
        "embed",
        "Embed URL (YouTube / Vimeo)"
      ],
      [
        "hubspot",
        "HubSpot-hosted video"
      ]
    ],
    "default": "embed",
    "help_text": "Choose a video hosted in HubSpot, or paste a YouTube/Vimeo embed URL.",
    "visibility": {
      "controlling_field_path": "media_type",
      "operator": "EQUAL",
      "controlling_value_regex": "video"
    }
  },
  {
    "name": "hubspot_video",
    "label": "HubSpot video",
    "type": "videoplayer",
    "help_text": "Pick a video hosted in HubSpot (Marketing > Files and Templates > Files). Uses HubSpot's own player, so plays are tracked against the contact record. Poster image and play-button label below only apply to the embed URL source - the HubSpot player uses its own thumbnail.",
    "default": {
      "player_id": null,
      "size_type": "auto_full_width",
      "width": 1280,
      "height": 720,
      "loop_video": false,
      "mute_by_default": false,
      "autoplay": false,
      "hide_controls": false
    },
    "advanced_visibility": {
      "boolean_operator": "AND",
      "criteria": [
        {
          "controlling_field_path": "media_type",
          "operator": "EQUAL",
          "controlling_value_regex": "video"
        },
        {
          "controlling_field_path": "video_source",
          "operator": "EQUAL",
          "controlling_value_regex": "hubspot"
        }
      ]
    }
  },
  {
    "name": "video_url",
    "label": "Video embed URL",
    "type": "text",
    "help_text": "YouTube/Vimeo embed URL (e.g. https://www.youtube.com/embed/ID).",
    "advanced_visibility": {
      "boolean_operator": "AND",
      "criteria": [
        {
          "controlling_field_path": "media_type",
          "operator": "EQUAL",
          "controlling_value_regex": "video"
        },
        {
          "controlling_field_path": "video_source",
          "operator": "EQUAL",
          "controlling_value_regex": "embed"
        }
      ]
    }
  },
