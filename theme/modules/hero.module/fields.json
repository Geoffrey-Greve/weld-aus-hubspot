[
  {
    "name": "section_id",
    "label": "Section anchor ID (optional)",
    "type": "text",
    "help_text": "Used for in-page anchor links. Lower-case, hyphenated. Leave blank if not needed.",
    "default": ""
  },
  {
    "name": "background",
    "label": "Background style",
    "type": "choice",
    "choices": [
      [
        "primary",
        "Primary navy (default)"
      ],
      [
        "primary_dark",
        "Primary dark"
      ],
      [
        "surface",
        "Surface (light)"
      ],
      [
        "surface_alt",
        "Alt surface (subtle grey)"
      ],
      [
        "transparent",
        "Transparent"
      ]
    ],
    "default": "primary"
  },
  {
    "name": "spacing",
    "label": "Vertical spacing",
    "type": "choice",
    "choices": [
      [
        "compact",
        "Compact (32px)"
      ],
      [
        "default",
        "Default (64px)"
      ],
      [
        "spacious",
        "Spacious (96px)"
      ]
    ],
    "default": "default"
  },
  {
    "name": "visibility",
    "label": "Show on devices",
    "type": "choice",
    "display": "checkbox",
    "multiple": true,
    "choices": [
      [
        "mobile",
        "Mobile"
      ],
      [
        "tablet",
        "Tablet"
      ],
      [
        "desktop",
        "Desktop"
      ]
    ],
    "default": [
      "mobile",
      "tablet",
      "desktop"
    ]
  },
  {
    "name": "members_only",
    "label": "Members only",
    "type": "boolean",
    "default": false,
    "help_text": "When true, this section is only rendered for logged-in active members."
  },
  {
    "name": "show_breadcrumb",
    "label": "Show breadcrumb",
    "type": "boolean",
    "default": false,
    "help_text": "Renders a breadcrumb trail above the eyebrow. Use on section landing pages (Courses, Events, Resources)."
  },
  {
    "name": "show_breadcrumb_home",
    "label": "Show Home breadcrumb",
    "type": "boolean",
    "default": false,
    "help_text": "Adds a Home crumb before the parent crumb. Useful on detail templates.",
    "visibility": {
      "controlling_field_path": "show_breadcrumb",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "breadcrumb_home_label",
    "label": "Breadcrumb home label",
    "type": "text",
    "default": "Home",
    "visibility": {
      "controlling_field_path": "show_breadcrumb",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "breadcrumb_home_link",
    "label": "Breadcrumb home link",
    "type": "link",
    "visibility": {
      "controlling_field_path": "show_breadcrumb",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "breadcrumb_parent_label",
    "label": "Breadcrumb parent label",
    "type": "text",
    "default": "",
    "help_text": "Leave blank to show only the current page.",
    "visibility": {
      "controlling_field_path": "show_breadcrumb",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "breadcrumb_parent_link",
    "label": "Breadcrumb parent link",
    "type": "link",
    "visibility": {
      "controlling_field_path": "show_breadcrumb",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "breadcrumb_current_label",
    "label": "Breadcrumb current page label",
    "type": "text",
    "default": "",
    "visibility": {
      "controlling_field_path": "show_breadcrumb",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "eyebrow",
    "label": "Eyebrow / overline",
    "type": "text",
    "help_text": "Small uppercase label shown above the headline with a magenta accent rule. Optional.",
    "default": ""
  },
  {
    "name": "headline",
    "label": "Headline",
    "type": "text",
    "required": true,
    "default": ""
  },
  {
    "name": "subheadline",
    "label": "Sub-headline",
    "type": "richtext"
  },
  {
    "name": "extra_content",
    "label": "Extra hero content",
    "type": "richtext",
    "help_text": "Optional badges, tags or meta information shown below the sub-headline and above CTAs."
  },
  {
    "name": "media_type",
    "label": "Right-side media",
    "type": "choice",
    "choices": [
      [
        "image",
        "Image"
      ],
      [
        "video",
        "Video embed"
      ],
      [
        "text",
        "Text block"
      ],
      [
        "none",
        "None - no second column"
      ]
    ],
    "default": "none",
    "help_text": "What sits in the right-hand column beside the headline. Image, video and text all render as a second column - never as a full-bleed background. Choose \"None\" for a single full-width column of copy."
  },
  {
    "name": "background_image",
    "label": "Image",
    "type": "image",
    "help_text": "Shown in the right-hand media column beside the copy — same pattern as the page header. Never used as a background.",
    "visibility": {
      "controlling_field_path": "media_type",
      "operator": "EQUAL",
      "controlling_value_regex": "image"
    }
  },
  {
    "name": "video_embed_url",
    "label": "Video embed URL (optional)",
    "type": "text",
    "help_text": "A YouTube/Vimeo embed URL (e.g. https://www.youtube.com/embed/ID). When set, shows a 16:9 player beside the copy on desktop and a 'Watch video' link on smaller screens.",
    "default": "",
    "visibility": {
      "controlling_field_path": "media_type",
      "operator": "EQUAL",
      "controlling_value_regex": "video"
    }
  },
  {
    "name": "video_poster",
    "label": "Video poster image (optional)",
    "type": "image",
    "help_text": "Shown over the video before it plays. When set, the video only loads after the visitor clicks the play button (faster page load). Leave blank to load the embed immediately.",
    "responsive": false,
    "visibility": {
      "controlling_field_path": "media_type",
      "operator": "EQUAL",
      "controlling_value_regex": "video"
    }
  },
  {
    "name": "media_text",
    "label": "Right-side text",
    "type": "richtext",
    "help_text": "Rendered as a panel in the right-hand column beside the headline. Takes its own sub-heading, paragraphs and lists.",
    "visibility": {
      "controlling_field_path": "media_type",
      "operator": "EQUAL",
      "controlling_value_regex": "text"
    }
  },
  {
    "name": "alignment",
    "label": "Text alignment",
    "type": "choice",
    "choices": [
      [
        "left",
        "Left"
      ],
      [
        "center",
        "Center"
      ]
    ],
    "default": "left"
  },
  {
    "name": "primary_cta",
    "label": "Primary CTA",
    "type": "group",
    "children": [
      {
        "name": "label_text",
        "label": "Label",
        "type": "text"
      },
      {
        "name": "link",
        "label": "Link",
        "type": "link"
      },
      {
        "name": "style",
        "label": "Style",
        "type": "choice",
        "choices": [
          [
            "gold",
            "Gold (recommended on dark)"
          ],
          [
            "white-outline",
            "White outline"
          ],
          [
            "primary",
            "Navy filled"
          ],
          [
            "navy-outline",
            "Navy outline"
          ],
          [
            "accent",
            "Accent (gold alias)"
          ]
        ],
        "default": "gold"
      }
    ]
  },
  {
    "name": "secondary_cta",
    "label": "Secondary CTA",
    "type": "group",
    "children": [
      {
        "name": "label_text",
        "label": "Label",
        "type": "text"
      },
      {
        "name": "link",
        "label": "Link",
        "type": "link"
      },
      {
        "name": "style",
        "label": "Style",
        "type": "choice",
        "choices": [
          [
            "white-outline",
            "White outline (recommended on dark)"
          ],
          [
            "gold",
            "Gold"
          ],
          [
            "navy-outline",
            "Navy outline"
          ],
          [
            "outline",
            "Standard outline"
          ]
        ],
        "default": "white-outline"
      }
    ]
  },
  {
    "name": "show_search",
    "label": "Show hero search",
    "type": "boolean",
    "default": false,
    "help_text": "Adds a search form beneath the hero copy. Use for pages such as Find a Member, Resources, or Courses where search belongs in the hero."
  },
  {
    "name": "search_placeholder",
    "label": "Search placeholder",
    "type": "text",
    "default": "Search...",
    "visibility": {
      "controlling_field_path": "show_search",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "search_target",
    "label": "Search target",
    "type": "choice",
    "choices": [
      [
        "resource_library",
        "Resource Library"
      ],
      [
        "find_a_member",
        "Find a Member"
      ],
      [
        "course_timetable",
        "Course Timetable"
      ]
    ],
    "default": "resource_library",
    "visibility": {
      "controlling_field_path": "show_search",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "show_stats",
    "label": "Show stat tiles",
    "type": "boolean",
    "default": false,
    "help_text": "Adds a set of headline numbers to the hero. Independent of the right-side media setting."
  },
  {
    "name": "stats_placement",
    "label": "Stat tile placement",
    "type": "choice",
    "choices": [
      [
        "below",
        "Below the copy (full width row)"
      ],
      [
        "side",
        "Right-hand column (cards)"
      ]
    ],
    "default": "below",
    "help_text": "\"Right-hand column\" falls back to \"below the copy\" when an image or video already occupies the media column.",
    "visibility": {
      "controlling_field_path": "show_stats",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    }
  },
  {
    "name": "stats",
    "label": "Stat tiles",
    "type": "group",
    "occurrence": {
      "min": 0,
      "max": 6,
      "default": 4
    },
    "visibility": {
      "controlling_field_path": "show_stats",
      "operator": "EQUAL",
      "controlling_value_regex": "true"
    },
    "children": [
      {
        "name": "value",
        "label": "Value",
        "type": "text",
        "default": "",
        "help_text": "e.g. \"10,000+\". Ignored when a live count is selected below."
      },
      {
        "name": "stat_label",
        "label": "Label",
        "type": "text",
        "default": ""
      },
      {
        "name": "dynamic_value",
        "label": "Live count (optional)",
        "type": "choice",
        "choices": [
          [
            "none",
            "None - use the value above"
          ],
          [
            "open_roles_count",
            "Jobs listed"
          ],
          [
            "states_count",
            "States represented"
          ],
          [
            "employers_count",
            "Employers hiring"
          ],
          [
            "categories_count",
            "Job categories"
          ],
          [
            "remote_count",
            "Remote / FIFO roles"
          ],
          [
            "featured_count",
            "Featured roles"
          ]
        ],
        "default": "none",
        "help_text": "Reads live figures from the Job Board HubDB table. Only use on the Job Board page."
      }
    ]
  },
  {
    "name": "height",
    "label": "Hero height",
    "type": "choice",
    "choices": [
      [
        "banner",
        "Banner (160px min)"
      ],
      [
        "compact",
        "Compact (280px min)"
      ],
      [
        "medium",
        "Medium (420px min)"
      ],
      [
        "large",
        "Large (560px min)"
      ],
      [
        "tall",
        "Tall (640px min)"
      ],
      [
        "full",
        "Full viewport"
      ]
    ],
    "default": "medium"
  },
  {
    "name": "accent_bar",
    "label": "Show brand accent bar",
    "type": "boolean",
    "default": true,
    "help_text": "Renders the Weld Australia flame gradient (magenta → orange → gold) as a thin bar along the bottom edge of the hero."
  }
]
