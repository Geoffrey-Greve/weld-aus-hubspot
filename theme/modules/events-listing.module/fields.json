  {
    "name": "default_type_filter",
    "label": "Default event type",
    "type": "choice",
    "choices": [
      ["any", "All"],
      ["webinar", "Webinar"],
      ["in_person", "In-Person"],
      ["hybrid", "Hybrid"],
      ["awards", "Awards"]
    ],
    "default": "any"
  },
  {
    "name": "page_size",
    "label": "Results per page",
    "type": "number",
